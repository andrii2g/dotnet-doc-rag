{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=docrag;Username=docrag;Password=docrag"
  },
  "App": {
    "StoragePath": "/app/storage/documents",
    "ImportPath": "/app/import",
    "MaxUploadBytes": 26214400,
    "AllowedExtensions": [ ".txt", ".md", ".pdf", ".docx", ".html", ".htm", ".csv" ]
  },
  "Rag": {
    "ChunkTokenSize": 800,
    "ChunkTokenOverlap": 120,
    "DefaultTopK": 8,
    "MaxTopK": 20,
    "DefaultCandidateK": 24,
    "MaxCandidateK": 100,
    "MinSimilarity": 0.2,
    "HnswEfSearch": 100,
    "MaxContextTokens": 6000,
    "Temperature": 0.1
  },
  "AI": {
    "Provider": "OpenAI",
    "OpenAIApiKey": "",
    "ChatModel": "gpt-5.5"
  },
  "Security": {
    "ApiKey": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
